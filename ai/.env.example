# Campus Lost & Found — AI layer environment variables (NAMES ONLY).
#
# SECURITY: This file documents variable names only. It must never contain a
# real key. FEATHERLESS_API_KEY is a SERVER-SIDE secret: set it in the backend
# runtime (e.g. a Cloud Functions secret) and never expose it to the frontend.
# Copy this file to `.env` locally and fill values there — `.env` is gitignored.

# --- Featherless AI (server-side only) ---
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=
FEATHERLESS_TEXT_MODEL=
FEATHERLESS_VISION_MODEL=
FEATHERLESS_COMPARISON_MODEL=

# --- Provider request reliability ---
FEATHERLESS_TIMEOUT_MS=
FEATHERLESS_MAX_RETRIES=
FEATHERLESS_RETRY_BASE_MS=
FEATHERLESS_MAX_CONCURRENCY=

# --- Match decision thresholds (values must be between 0 and 1) ---
LFC_MATCH_POSSIBLE_THRESHOLD=
LFC_MATCH_STRONG_THRESHOLD=
